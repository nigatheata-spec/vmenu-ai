# =============================================================
# Vmenu.ai — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# =============================================================

# ── Supabase ──────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — server-only, NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── AI APIs (server-only) ─────────────────────────────────────
# Anthropic (Claude) — for AI Promos
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini — for Photo Enhancement
GEMINI_API_KEY=AIza...

# Fal.ai — for Video Generation (Kling, Hailuo, etc.)
FAL_API_KEY=...

# HeyGen — for UGC Avatar videos
HEYGEN_API_KEY=...

# ── App ───────────────────────────────────────────────────────
# Public base URL (used in email templates)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Demo mode (dev/staging only) ─────────────────────────────
# Set to "true" to show the demo login button on /login.
# The demo button bypasses Supabase — no API call is made.
# NEVER set this in production.
NEXT_PUBLIC_DEMO_MODE=false
